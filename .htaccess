# php -- BEGIN cPanel-generated handler, do not edit
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

Options -Indexes

# Prevent direct access to sensitive configuration, backup, and environment files
<FilesMatch "^\.env|^\.git|package\.json|tsconfig\.json|vite\.config\.ts|server\.ts">
    Order allow,deny
    Deny from all
</FilesMatch>

LimitRequestBody 104857600
# Markdown for Agents - serve auth.md directly
RewriteCond %{HTTP:Accept} text/markdown
RewriteRule ^$ /auth.md [L]
DirectoryIndex /dist/index.html

AddType application/javascript .js .mjs
AddType application/json .json
AddType text/markdown .md

RewriteEngine On

RewriteRule ^assets/(.*)$ /dist/assets/$1 [L]
RewriteRule ^app-assets/(.*)$ /dist/app-assets/$1 [L]
RewriteRule ^manifest\.json$ /dist/manifest.json [L]
RewriteRule ^manifest\.webmanifest$ /dist/manifest.webmanifest [L]
RewriteRule ^sw\.js$ /dist/sw.js [L]
RewriteRule ^workbox-(.*)$ /dist/workbox-$1 [L]
RewriteRule ^robots\.txt$ /dist/robots.txt [L]
RewriteRule ^sitemap\.xml$ /dist/sitemap.xml [L]

RewriteCond %{REQUEST_URI} ^/api/ [OR]
RewriteCond %{REQUEST_URI} ^/socket.io/ [OR]
RewriteCond %{REQUEST_URI} ^/\.well-known/ [OR]
RewriteCond %{REQUEST_URI} ^/auth\.md$
RewriteRule ^(.*)$ http://localhost:3000/$1 [P,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /dist/index.html [L]

# RFC 8288 Link Headers for agent discovery
Header always set Link '</.well-known/api-catalog>; rel="api-catalog", </.well-known/oauth-authorization-server>; rel="oauth-authorization-server", </.well-known/oauth-protected-resource>; rel="oauth-protected-resource", </auth.md>; rel="service-doc", </.well-known/mcp/server-card.json>; rel="service-desc", </.well-known/acp.json>; rel="acp"'
